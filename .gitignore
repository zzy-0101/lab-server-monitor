# Publish only the application, README and two PDF manuals.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/服务器监控.command
!/Install-Windows.bat
!/Start-Windows.bat
!/lab_servers/
!/tools/
!/docs/

/lab_servers/*
!/lab_servers/dashboard.py
!/lab_servers/monitor.py
!/lab_servers/remote_probe.py
!/lab_servers/credential_store.py
!/lab_servers/paths.py
!/lab_servers/transport.py
!/lab_servers/transport_paramiko.py
!/lab_servers/requirements-windows.txt
!/lab_servers/servers.example.json
!/lab_servers/web/
/lab_servers/web/*
!/lab_servers/web/index.html
!/lab_servers/web/style.css
!/lab_servers/web/app.js

/tools/*
!/tools/launch_monitor.py
!/tools/monitor-cli.command

/docs/*
!/docs/guide/
!/docs/references/
/docs/guide/*
!/docs/guide/服务器监控入门指南.pdf
/docs/references/*
!/docs/references/服务器使用指南.pdf
