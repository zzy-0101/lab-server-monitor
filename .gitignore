# Publish only the application, README and two PDF manuals.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/服务器监控.command
!/Install-Windows.bat
!/Start-Windows.bat
!/server_monitor/
!/tools/
!/docs/

/server_monitor/*
!/server_monitor/dashboard.py
!/server_monitor/monitor.py
!/server_monitor/remote_probe.py
!/server_monitor/credential_store.py
!/server_monitor/paths.py
!/server_monitor/transport.py
!/server_monitor/transport_paramiko.py
!/server_monitor/requirements-windows.txt
!/server_monitor/servers.example.json
!/server_monitor/web/
/server_monitor/web/*
!/server_monitor/web/index.html
!/server_monitor/web/style.css
!/server_monitor/web/app.js

/tools/*
!/tools/launch_monitor.py
!/tools/monitor-cli.command

/docs/*
!/docs/guide/
!/docs/references/
/docs/guide/*
!/docs/guide/服务器监控入门指南.pdf
/docs/references/*
!/docs/references/服务器使用指南.pdf
